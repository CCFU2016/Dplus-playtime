{
  "name": "direct-plus-limits",
  "private": true,
  "description": "Direct+ calculators: ECC trading limits from collateral (and back), and the Direct+ wallet a member needs",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:ecc": "node scripts/build.js ecc",
    "build:wallet": "node scripts/build.js wallet",
    "start": "node scripts/serve.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:ui": "node scripts/build.js && python3 tests/ui/run.py",
    "lint": "eslint .",
    "lint:py": "ruff check tests/ui && ruff format --check tests/ui",
    "format": "prettier --write .",
    "format:py": "ruff format tests/ui",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9"
  }
}
